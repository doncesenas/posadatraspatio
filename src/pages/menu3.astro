---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuCard from "../components/MenuCard.astro";
import "../styles/global.css";

const platosfuertes3 = [
    {
        name: "Parrillada de Pulpo",
        desc: "Pulpo al grill con la receta de la casa acompañado de verduras",
        image: "/images/parrilladapulpo.webp",
    },
    {
        name: "Plato dorado",
        desc: "Pasta fettuccine + camarones al grill con salsa de la casa",
        image: "/images/pasta.jpg",
    },
    {
        name: "Parrillada de Sirloin",
        desc: "Parrillad de Sirloin para 2 personas",
        image: "/images/parrilladasirloin.webp",
    },

    {
        name: "Chicharrón de Pescado y Camarón",
        desc: "El tradicional y popular chicharrón de pescado con chicharron de camarón, todo en un mismo molcajete",
        image: "/images/chicharrondepescado.webp",
    },
];
const bebidas = [
    {
        name: "Cubeta de Cerveza",
        desc: "10 cervezas de marca a elegir ",
        image: "/images/cubeta.png",
    },
    {
        name: "Coctelería",
        desc: "2 bebidas de nuestro menú de coctelería a elegir ",
        image: "/images/pantera.png",
    },
];
---

<BaseLayout title="Menú Tradicional | El Traspatio">
    <section class="relative py-16 bg-cover bg-center bg-no-repeat">
        <!-- Overlay oscuro con blur -->
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>

        <!-- Contenido -->
        <div class="relative z-10 text-center px-6 gruop">
            <h1 class="text-4xl font-bold text-[#84BF49] mb-4 drop-shadow-md">
                Paquete Deluxe Mar & Grill
            </h1>
            <p class="text-[#edd9bc] mb-10 max-w-2xl mx-auto">
                Una experiencia exclusiva de parilladas de Pulpo, Sirloin, Pasta
                Dorada de la Casa, y los platillos más populares del Traspatio
                <strong> <br />Paquete para 8 personas.</strong>
            </p>

            <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
                {
                    platosfuertes3.map((item) => (
                        <div class="border border-[#D4AF37]/40 rounded-2xl p-6 bg-black/40 backdrop-blur-sm hover:bg-black/60 hover:scale-105 hover:shadow-[0_0_25px_#D4AF37]/20 transition-all duration-500">
                            <MenuCard {...item} />
                        </div>
                    ))
                }
            </div>

            <div class="max-w-5xl mx-auto">
                <h2
                    class="text-2xl font-semibold text-[#D4AF37] mb-6 inline-block pb-2"
                >
                    Bebidas
                </h2>
                <h3
                    class="text-1xl text-[#D4AF37] mb-6 border-b border-[#D4AF37]/40 pb-2"
                >
                    1 a elegir
                </h3>

                <div class="grid md:grid-cols-3 gap-6 mt-6">
                    {
                        bebidas.map((item) => (
                            <div class="border border-[#D4AF37]/40 rounded-2xl p-6 bg-black/40 hover:bg-black/60 hover:scale-105 hover:shadow-[0_0_25px_#D4AF37]/20 transition-all duration-500">
                                <MenuCard {...item} />
                            </div>
                        ))
                    }
                </div>
            </div>

            <a
                href="/reservaciones"
                class="mt-12 inline-block bg-[#A6342A] hover:bg-[#D4AF37] text-white font-semibold px-6 py-3 rounded-lg transition-all duration-300 shadow-lg hover:shadow-[#D4AF37]/30"
            >
                Reservar este menú
            </a>
        </div>
    </section>
</BaseLayout>
