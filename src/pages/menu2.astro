---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuCard from "../components/MenuCard.astro";
import "../styles/global.css";
import { imageConfig } from "astro:assets";

const entradas2 = [
    {
        name: "Chicharron de Pescado",
        desc: "2 unidades de Chicharrón de pescado",
        image: "/images/chicharrondepescado.webp",
    },
    {
        name: "Camarones Mazatlán",
        desc: "Deliciosos camarones Mazatlán para 2 personas",
        image: "/images/camaronesmazatlan.webp",
    },
    {
        name: "Costillas al tajín con guacamole",
        desc: "2 unidades de gucamole tradicional acompañado de deliciosas costillas al tajín",
        image: "/images/costillas.webp",
    },
];

const bebidas = [
    {
        name: "Cubeta de Cerveza",
        desc: "8 cubetas de cerveza a de marca a elegir ",
        image: "/images/cubeta.png",
    },
];
---

<BaseLayout title="Paquete Premium | El Traspatio">
    <section class="relative py-16 bg-cover bg-center bg-no-repeat">
        <!-- Fondo degradado oscuro -->
        <div
            class="absolute inset-0 bg-linear-to-b from-black/70 via-black/50 to-black/70"
        >
        </div>

        <div class="relative z-10 text-center px-6">
            <h1 class="text-4xl font-bold text-[#84BF49] mb-4 drop-shadow-md">
                Paquete Fiesta
            </h1>
            <p class="text-[#F8E9D2] mb-10 max-w-2xl mx-auto">
                Pa’ los que vienen a pistear sabroso. Botaneas con chicharrón de
                pescado, camarones y costillas tajín mientras te echas las
                cubetas bien frías.

                <strong> <br />Paquete para 8 personas.</strong>
            </p>

            <div class="max-w-5xl mx-auto mb-16">
                <h2
                    class="text-2xl font-semibold text-[#D4AF37] mb-6 border-b border-[#D4AF37]/40 pb-2"
                >
                    Pa acompañar
                </h2>

                <div class="grid md:grid-cols-3 gap-6 mt-6">
                    {
                        entradas2.map((item) => (
                            <div class="border border-[#D4AF37]/40 rounded-2xl p-6 bg-black/40 hover:bg-black/60 hover:scale-105 hover:shadow-[0_0_25px_#D4AF37]/20 transition-all duration-500">
                                <MenuCard {...item} />
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="max-w-5xl mx-auto">
                <h2
                    class="text-2xl font-semibold text-[#D4AF37] mt-10 border-b border-[#D4AF37]/40 mb-6 pb-2"
                >
                    Pa pistear
                </h2>

                <div class="grid md:grid-cols-3 gap-6 mt-6">
                    {
                        bebidas.map((item) => (
                            <div class="border border-[#D4AF37]/40 rounded-2xl p-6 bg-black/40 hover:bg-black/60 hover:scale-105 hover:shadow-[0_0_25px_#D4AF37]/20 transition-all duration-500">
                                <MenuCard {...item} />
                            </div>
                        ))
                    }
                </div>
            </div>

            <a
                href="/reservaciones"
                class="mt-16 inline-block bg-[#A6342A] hover:bg-[#D4AF37] text-white font-semibold px-6 py-3 rounded-lg transition-all duration-300 shadow-lg hover:shadow-[#D4AF37]/30"
            >
                Reservar este menú
            </a>
        </div>
    </section>
</BaseLayout>
