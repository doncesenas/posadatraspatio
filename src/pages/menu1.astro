---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuCard from "../components/MenuCard.astro";
import "../styles/global.css";
import { imageConfig } from "astro:assets";
const entradas = [
    {
        name: "Queso fundido",
        desc: "Queso flameado con chorizo, servido con tortillas de harina.",

        image: "/images/queso.webp",
    },
    {
        name: "Guacamole con pico de gallo",
        desc: "El gucamole de la casa acompañado de Costillas al tajín",

        image: "/images/guacamole.webp",
    },
];

const platosFuertes = [
    {
        name: "Tacos Gober",
        desc: "Orden de 4 tacos al estilo gobernador.",
        image: "/images/tacogober.webp",
    },
    {
        name: "Tacos de Arrachera",
        desc: "Orden de 4 tacos de arrachera acompañado de verdura",
        image: "/images/tacodiezmillo.webp",
    },
    {
        name: "Tacos de Sirloin",
        desc: "Orden de 4 tacos de Sirloin acompañado de verdura",
        image: "/images/tacoarrachera.webp",
    },
];

const bebidas = [
    {
        name: "Cerveza",
        desc: "5 cervezas a de marca a elegir ",
        image: "/images/cubeta.png",
    },
    {
        name: "Coctelería",
        desc: "2 bebidas de nuestro menú de coctelería a elegir ",
        image: "/images/pantera.png",
    },
];
---

<BaseLayout title="Paquete Premium | El Traspatio">
    <section class="relative py-16 bg-cover bg-center bg-no-repeat">
        <div
            class="absolute inset-0 bg-linear-to-b from-black/70 via-black/50 to-black/70"
        >
        </div>

        <div class="relative z-10 text-center px-6">
            <h1 class="text-4xl font-bold text-[#84BF49] mb-4 drop-shadow-md">
                Paquete Sabor Traspatio
            </h1>
            <p class="text-[#F8E9D2] mb-10 max-w-2xl mx-auto">
                La experiencia completa que necesitas para disfrutar las
                entradas y los platos fuertes.
            </p>

            <div class="max-w-5xl mx-auto mb-16">
                <h2
                    class="text-2xl font-semibold text-[#D4AF37] mb-6 inline-block pb-2"
                >
                    Entradas
                </h2>
                <h3
                    class="text-1xl text-[#D4AF37] mb-6 border-b border-[#D4AF37]/40 pb-2"
                >
                    1 a elegir
                </h3>

                <div class="grid md:grid-cols-3 gap-6 mt-6">
                    {
                        entradas.map((item) => (
                            <div class="border border-[#D4AF37]/40 rounded-2xl p-6 bg-black/40 hover:bg-black/60 hover:scale-105 hover:shadow-[0_0_25px_#D4AF37]/20 transition-all duration-500">
                                <MenuCard {...item} />
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="max-w-5xl mx-auto">
                <h2
                    class="text-2xl font-semibold text-[#D4AF37] mb-6 inline-block pb-2"
                >
                    Platos Fuertes
                </h2>
                <h3
                    class="text-1xl text-[#D4AF37] mb-6 border-b border-[#D4AF37]/40 pb-2"
                >
                    1 a elegir
                </h3>

                <div class="grid md:grid-cols-3 gap-6 mt-6">
                    {
                        platosFuertes.map((item) => (
                            <div class="border border-[#D4AF37]/40 rounded-2xl p-6 bg-black/40 hover:bg-black/60 hover:scale-105 hover:shadow-[0_0_25px_#D4AF37]/20 transition-all duration-500">
                                <MenuCard {...item} />
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="max-w-5xl mx-auto">
                <h2
                    class="text-2xl font-semibold text-[#D4AF37] mt-10 mb-6 pb-2"
                >
                    Bebidas
                </h2>
                <h3
                    class="text-1xl text-[#D4AF37] mb-6 border-b border-[#D4AF37]/40 pb-2"
                >
                    1 a elegir
                </h3>

                <div class="grid md:grid-cols-3 gap-6 mt-6">
                    {
                        bebidas.map((item) => (
                            <div class="border border-[#D4AF37]/40 rounded-2xl p-6 bg-black/40 hover:bg-black/60 hover:scale-105 hover:shadow-[0_0_25px_#D4AF37]/20 transition-all duration-500">
                                <MenuCard {...item} />
                            </div>
                        ))
                    }
                </div>
            </div>

            <a
                href="/reservaciones"
                class="mt-16 inline-block bg-[#A6342A] hover:bg-[#D4AF37] text-white font-semibold px-6 py-3 rounded-lg transition-all duration-300 shadow-lg hover:shadow-[#D4AF37]/30"
            >
                Reservar este menú
            </a>
        </div>
    </section>
</BaseLayout>
